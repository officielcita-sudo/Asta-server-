# Copy this file to .env and fill in the values. Real environment variables
# (e.g. set in Railway's Variables tab) override anything in .env.

# Port the server listens on. Railway, Render and Fly set this automatically.
PORT=3000

# Set to "production" when deployed. In production the server refuses to start
# unless RESEND_API_KEY and a SESSION_SECRET of 32+ characters are set.
NODE_ENV=development

# Set to 1 when running behind a reverse proxy or platform load balancer
# (Railway, Render, Fly, nginx) so rate limits use the real visitor IP.
# Leave at 0 if the server is exposed directly, or visitors can fake their IP.
TRUST_PROXY=0

# Secret used to sign verification tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Resend (https://resend.com) API key, used to email verification codes.
# Without it, codes are printed in the server terminal (local testing only).
RESEND_API_KEY=

# Sender for verification emails. Must use a domain verified in Resend.
# Resend's test sender onboarding@resend.dev can only email your own Resend account address.
MAIL_FROM="Asta Security <verify@yourdomain.com>"

# Address shown in Contact links. Contact links are hidden while this is unset.
CONTACT_EMAIL=

# Public address of the site, without a trailing slash. Used for link previews
# (Facebook, WhatsApp, X, LinkedIn), canonical links and the sitemap.
SITE_URL=https://your-site.onrender.com
